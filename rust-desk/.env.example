# RustDesk Server - Variáveis de Ambiente
# Copie este arquivo para .env e customize conforme necessário

# Chave de segurança (mude em produção)
RUSTDESK_KEY=_000000

# Limite de CPU (cores)
COMPOSE_PROFILES=default

# Timezone (Brasil)
TZ=America/Sao_Paulo

# Log level (debug, info, warn, error)
LOG_LEVEL=info
