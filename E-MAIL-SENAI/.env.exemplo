# =============================================================================
# E-MAIL-SENAI — modelo de configuração
# Copie para `.env` e preencha. O `.env` está no .gitignore e NUNCA é commitado.
# =============================================================================
#
# ATENÇÃO: este arquivo NÃO é lido pelo navegador.
# O app é HTML/CSS/JS puro, sem build e sem backend — não existe `process.env`
# no browser. O `.env` serve apenas como cofre local, de onde os valores são
# levados para o Supabase Vault (é lá que a função sincronizar_resend() lê).
#
# Depois de preencher, rode no SQL Editor do Supabase:
#
#   select vault.create_secret('<RESEND_API_KEY>',     'RESEND_API_KEY',     'Chave da API do Resend');
#   select vault.create_secret('<RESEND_AUDIENCE_ID>', 'RESEND_AUDIENCE_ID', 'Audience padrao do E-MAIL-SENAI');
#
# =============================================================================

# Chave da API do Resend — https://resend.com/api-keys → Create API Key
# Permissão necessária: Full access. Aparece uma única vez ao ser criada.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID da Audience — https://resend.com/audiences → Create Audience
# Não é uma chave: é o UUID da lista de contatos.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Remetente padrão dos envios (precisa de domínio verificado em
# https://resend.com/domains). Para teste, use onboarding@resend.dev —
# mas ele só entrega no e-mail da sua própria conta Resend.
RESEND_FROM=professor@senai.br

# -----------------------------------------------------------------------------
# Supabase — valores públicos, já embutidos em assets/js/config.js.
# Repetidos aqui apenas para referência.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://jwasbzdbkbryncpvfujc.supabase.co
SUPABASE_PROJECT_REF=jwasbzdbkbryncpvfujc

# Token da API do Purelymail (criacao em lote das contas dos alunos)
# purelymail.com -> Account -> "Refresh API Key"
PURELYMAIL_API_TOKEN=
